+X87_INLINE bool fx_dbl(floatx80 a, double *out)
+{
+    uint64_t m = a.low, bits;
+    int32_t de = (int32_t)(a.high & 0x7fff) - 16383 + 1023;
+    if ((m & 0x7ff) || !(m >> 63) || de < 2 || de > 2045) {
+        return false;
+    }
+    bits = ((uint64_t)(a.high >> 15) << 63) | ((uint64_t)de << 52) | ((m >> 11) & 0xFFFFFFFFFFFFFULL);
+    memcpy(out, &bits, 8);
+    return true;
+}
+
+X87_INLINE bool dbl_fx(double d, floatx80 *out)
+{
+    uint64_t bits;
+    uint32_t de;
+    memcpy(&bits, &d, 8);
+    de = (bits >> 52) & 0x7ff;
+    if (de < 2 || de > 2045) {
+        return false;
+    }
+    out->high = (uint16_t)(((bits >> 63) << 15) | (de - 1023 + 16383));
+    out->low = (1ULL << 63) | ((bits & 0xFFFFFFFFFFFFFULL) << 11);
+    return true;
+}
+
+/* fx_dbl, and exact zeros too (*zero set) */
+X87_INLINE bool fx_dblz(floatx80 a, double *out, bool *zero)
+{
+    if ((a.high & 0x7fff) == 0 && a.low == 0) {
+        *out = (a.high >> 15) ? -0.0 : 0.0;
+        *zero = true;
+        return true;
+    }
+    *zero = false;
+    return fx_dbl(a, out);
+}
