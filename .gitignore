.DS_Store

# Game data: ignored against accidental bloat (bring your own copy of the game).
# A game file may be committed on purpose with `git add -f` (D961); the leak
# guard, tests/_leak_guard.py, refuses only an ISO image or a part of one, an
# xemu disk, an EEPROM dump, a guest RAM snapshot and a private key.
/iso/
*.iso
*.xiso
*.xbe
*.xbr
*.sav
*.xbx
*.qcow2
*eeprom*.bin
gamedata/
movies/
!/devkit/movies/

# Tools fetched for the tests (Pyodide: scripts/web_tools.py), shared by every lane
/.tools/

# The checked randomizer database the wheel's and the app's builds ship (dbcache.ship): generated, never in the tree
/src/azurkit/tools/randomizer/shipped/
